<script>
// Post-body typography touch-ups, applied after MathJax finishes:
//   1. technical terms are highlighted on their FIRST appearance per language
//   2. standalone numbers get the same blue as the math
//
// Two safeguards keep this from corrupting formulas: it runs only after
// MathJax resolves (formula source is by then replaced by <mjx-container>),
// and it never touches a text node that still contains '$' or a backslash,
// so unrendered LaTeX source is always left alone.
(function () {
  var SKIP = { PRE: 1, CODE: 1, A: 1, H1: 1, H2: 1, H3: 1, H4: 1, H5: 1, H6: 1,
               SCRIPT: 1, STYLE: 1, BUTTON: 1, SVG: 1 };

  var TERMS = [
    // theorems, linear algebra, statistics
    'Eckart–Young 定理', 'Eckart–Young theorem', 'Eckart–Young',
    'singular value decomposition', '奇异值分解',
    'ridge regression', '岭回归', 'least squares', '最小二乘',
    'Cholesky', 'Frobenius', 'Fisher',
    'cross-entropy', '交叉熵', 'KL divergence', 'KL 散度',
    'unigram', 'softmax', 'whitened', 'whitening', '白化',
    // architecture
    'Transformer', 'SwiGLU', 'RMSNorm', 'residual stream', '残差流',
    'lm_head', 'embedding',
    // methods and literature
    'plain SVD', 'ASVD', 'SVD-LLM', 'Dobi-SVD', 'LACE-SVD', 'UniRank', 'D-Rank',
    'HASSLE-free', 'LoSparse', 'OATS', 'BA-LoRA', 'LoRA', 'GPTQ', 'AWQ',
    // phenomena
    'representation collapse', '表示坍缩',
    'massive activation', '巨幅激活',
    'superposition', '超位置',
    'effective rank', '有效秩',
    // models and data
    'Qwen3-8B', 'FineWeb-Edu', 'LLaMA-7B'
  ];

  function escapeRe(s) { return s.replace(/[.*+?^=!:$(){}|[\]\/\\-]/g, '\\$&'); }

  var TERM_RE = new RegExp('(' + TERMS.slice()
    .sort(function (a, b) { return b.length - a.length; })
    .map(escapeRe).join('|') + ')', 'g');
  var NUM_RE = /(\d+(?:[.,]\d+)?%?)/g;

  function textNodes(root, insideOk) {
    var walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: function (node) {
        var v = node.nodeValue;
        if (v.indexOf('$') !== -1 || v.indexOf('\\') !== -1) return NodeFilter.FILTER_REJECT;
        for (var el = node.parentNode; el && el !== root; el = el.parentNode) {
          var tag = el.nodeName.toUpperCase();
          if (SKIP[tag] || tag.indexOf('MJX') === 0) return NodeFilter.FILTER_REJECT;
          if (el.classList && !insideOk(el.classList)) return NodeFilter.FILTER_REJECT;
        }
        return NodeFilter.FILTER_ACCEPT;
      }
    });
    var out = [], n;
    while ((n = walker.nextNode())) out.push(n);
    return out;
  }

  // Split a text node on `re`, wrapping matches in <span class=cls>.
  // `keep` decides per match whether to wrap it at all.
  function wrap(node, re, cls, keep) {
    var parts = node.nodeValue.split(re);
    if (parts.length < 2) return;
    var frag = document.createDocumentFragment(), touched = false;
    parts.forEach(function (part, i) {
      if (!part) return;
      if (i % 2 === 1 && (!keep || keep(part))) {
        var span = document.createElement('span');
        span.className = cls;
        span.textContent = part;
        frag.appendChild(span);
        touched = true;
      } else {
        frag.appendChild(document.createTextNode(part));
      }
    });
    if (touched) node.parentNode.replaceChild(frag, node);
  }

  function decorate(scope) {
    // Terms already marked (e.g. this ran once before) count as seen, so
    // re-running never promotes a second occurrence.
    var seen = {};
    Array.prototype.forEach.call(scope.querySelectorAll('.term'), function (el) {
      seen[el.textContent] = true;
    });
    textNodes(scope, function (cl) { return !cl.contains('term'); }).forEach(function (node) {
      wrap(node, TERM_RE, 'term', function (m) {
        if (seen[m]) return false;
        seen[m] = true;
        return true;
      });
    });
    textNodes(scope, function (cl) {
      return !cl.contains('num-blue') && !cl.contains('term');
    }).forEach(function (node) {
      if (/\d/.test(node.nodeValue)) wrap(node, NUM_RE, 'num-blue', null);
    });
  }

  function run() {
    var body = document.querySelector('.post-body');
    if (!body) return;
    var langs = body.querySelectorAll('.lang-content');
    if (langs.length) {
      Array.prototype.forEach.call(langs, decorate);
    } else {
      decorate(body);
    }
  }

  function runAfterMath() {
    var tries = 0;
    (function poll() {
      if (window.MathJax && MathJax.startup && MathJax.startup.promise) {
        MathJax.startup.promise.then(run).catch(run);
      } else if (++tries < 200) {
        setTimeout(poll, 100);
      } else {
        run();
      }
    })();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runAfterMath);
  } else {
    runAfterMath();
  }
  document.addEventListener('page:loaded', runAfterMath);
})();
</script>
