// ============================================================
// Clean academic blog layout (Mist scheme - top nav)
// - Unified white background
// - Wide centered content
// - Sidenotes float right on desktop, inline on mobile
// - TOC in sidebar (desktop: visible, mobile: collapsible)
// ============================================================

// ---- Unified background ----
body {
  background: #fff;
}

.header-inner, .main-inner, .footer-inner {
  background: #fff;
}

// Remove any card shadow / background differences
.post-block {
  background: transparent;
  box-shadow: none;
  border: none;
}

// ---- Wider content area ----
.main-inner {
  max-width: 850px;
  margin: 0 auto;
}

@media (min-width: 1400px) {
  .main-inner {
    max-width: 900px;
  }
}

// ---- Post body ----
.post-body {
  position: relative;
  padding-right: 0;
}

// On wide desktop, reserve space for sidenotes in the right margin
@media (min-width: 1300px) {
  .main-inner {
    max-width: 1100px;
  }
  
  .post-body {
    padding-right: 280px;
  }
}

// ---- Sidenote styling ----

// The inline [N] superscript in text
sup.sidenote-ref {
  font-size: 0.75em;
  color: #1e6e78;
  font-weight: 600;
  cursor: default;
}

// Default: sidenote content is shown as inline block (mobile/tablet)
.sidenote, .marginnote {
  display: block;
  margin: 0.6em 0;
  padding: 8px 12px;
  font-size: 0.82em;
  line-height: 1.5;
  color: #555;
  background: #f8f9fa;
  border-left: 3px solid #1e6e78;
  border-radius: 4px;
}

// On wide desktop (1300px+), float sidenotes to right margin
@media (min-width: 1300px) {
  .sidenote, .marginnote {
    float: right;
    clear: right;
    width: 250px;
    margin-right: -280px;
    margin-left: 12px;
    margin-bottom: 14px;
    margin-top: 0;
    padding: 8px 12px;
    background: #f9fafb;
    border-left: 3px solid #1e6e78;
    border-radius: 3px;
  }
}

// The [N] label inside the sidenote margin box
.sidenote-num {
  font-size: 0.85em;
  font-weight: bold;
  color: #1e6e78;
}

.sidenote p, .marginnote p {
  margin: 0 0 4px 0;
  display: inline;
}

// ---- Note boxes ----
.note {
  border-radius: 6px;
  margin: 1.2em 0;
  padding: 12px 16px;
  font-size: 0.92em;
  line-height: 1.6;
}

.note.info {
  background-color: #f0f9ff;
  border-left: 4px solid #1e6e78;
}

.note.warning {
  background-color: #fff8f0;
  border-left: 4px solid #c07830;
}

.note.danger {
  background-color: #fff0f0;
  border-left: 4px solid #c03030;
}

.note.success {
  background-color: #f0fff4;
  border-left: 4px solid #2e8b57;
}

.note.default {
  background-color: #f8f8fa;
  border-left: 4px solid #888;
}

// ---- Math display ----
.post-body .MathJax_Display {
  overflow-x: auto;
  overflow-y: hidden;
  padding: 8px 0;
}

.post-body mjx-container {
  overflow-x: auto;
  overflow-y: hidden;
  max-width: 100%;
}

.post-body mjx-container[display="true"] {
  margin: 1em 0;
}

// ---- Mobile-specific ----
@media (max-width: 767px) {
  .post-body {
    padding-right: 0 !important;
    padding-left: 0;
  }

  .post-body mjx-container[display="true"] {
    overflow-x: auto;
    max-width: 100%;
    font-size: 0.9em;
  }

  .sidenote, .marginnote {
    float: none !important;
    width: auto !important;
    margin-right: 0 !important;
    margin-left: 0 !important;
  }

  .lang-switch {
    text-align: center;
  }

  .note {
    padding: 10px 12px;
    font-size: 0.88em;
  }

  .post-title {
    font-size: 1.4em !important;
  }
}

// ---- Heading styles ----
.post-body h2 {
  margin-top: 2em;
  padding-bottom: 0.3em;
  border-bottom: 1px solid #eaeaea;
}

.post-body h3 {
  margin-top: 1.5em;
  color: #2c3e50;
}

// ---- TOC ----
// Hide the "Table of Contents" / "Overview" nav tabs
.sidebar-nav {
  display: none !important;
}

.post-toc .nav .nav-child {
  display: block;
}

.post-toc-wrap {
  font-size: 0.85em;
}

// ---- Typography ----
.post-body p {
  line-height: 1.8;
  margin-bottom: 1em;
}

.post-body ol, .post-body ul {
  line-height: 1.8;
}

.post-body li {
  margin-bottom: 0.3em;
}

// ---- Hide footer ----
.footer {
  display: none;
}

// ---- Language toggle button ----
.lang-switch {
  text-align: right;
  margin-bottom: 1.5em;
  padding: 8px 0;
  border-bottom: 1px solid #eee;
}

.lang-btn {
  display: inline-block;
  padding: 4px 14px;
  margin-left: 6px;
  border: 1px solid #ccc;
  border-radius: 4px;
  background: #fff;
  color: #555;
  font-size: 0.85em;
  cursor: pointer;
  transition: all 0.2s ease;
}

.lang-btn:hover {
  border-color: #1e6e78;
  color: #1e6e78;
}

.lang-btn.active {
  background: #1e6e78;
  border-color: #1e6e78;
  color: #fff;
  font-weight: 600;
}
