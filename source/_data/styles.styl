// ============================================================
// Clean academic blog layout (Mist scheme - top nav)
// - Academic fonts (serif body, sans-serif headings)
// - Unified white background
// - Wide centered content
// - Sidenotes always inline (no right-float to avoid mobile issues)
// ============================================================

// ---- Google Fonts import ----
@import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&family=Source+Sans+3:wght@400;600;700&family=Noto+Serif+SC:wght@400;700&family=Noto+Sans+SC:wght@400;700&family=JetBrains+Mono:wght@400;500&display=swap');

// ---- Typography: Academic fonts ----
body {
  font-family: "Source Serif 4", "Noto Serif SC", Georgia, "Times New Roman", serif;
  font-size: 16px;
  background: #fff;
}

// Headings: sans-serif for contrast
.post-title, .post-body h1, .post-body h2, .post-body h3, .post-body h4 {
  font-family: "Source Sans 3", "Noto Sans SC", -apple-system, "Helvetica Neue", sans-serif;
}

// Code
code, pre {
  font-family: "JetBrains Mono", "Fira Code", monospace;
}

// Nav bar
.site-nav, .menu {
  font-family: "Source Sans 3", "Noto Sans SC", sans-serif;
}

// ---- Unified background ----
.header-inner, .main-inner, .footer-inner {
  background: #fff;
}

.post-block {
  background: transparent;
  box-shadow: none;
  border: none;
}

// ---- Content width: wide and centered ----
.main-inner {
  max-width: 780px;
  width: 90%;
  margin: 0 auto;
}

// ---- Post body ----
.post-body {
  position: relative;
  padding-right: 0;
  padding-left: 0;
}

// ---- Note boxes ----
.note {
  border-radius: 6px;
  margin: 1.2em 0;
  padding: 12px 16px;
  font-size: 0.92em;
  line-height: 1.6;
}

.note.info {
  background-color: #f0f9ff;
  border-left: 4px solid #1e6e78;
}

.note.warning {
  background-color: #fff8f0;
  border-left: 4px solid #c07830;
}

.note.danger {
  background-color: #fff0f0;
  border-left: 4px solid #c03030;
}

.note.success {
  background-color: #f0fff4;
  border-left: 4px solid #2e8b57;
}

.note.default {
  background-color: #f8f8fa;
  border-left: 4px solid #888;
}

// ---- Math display ----
.post-body .MathJax_Display {
  overflow-x: auto !important;
  overflow-y: hidden;
  padding: 8px 0;
  max-width: 100% !important;
}

.post-body mjx-container {
  overflow-x: auto !important;
  overflow-y: hidden;
  max-width: 100% !important;
}

.post-body mjx-container[display="true"] {
  margin: 1em 0;
  overflow-x: auto !important;
  max-width: 100% !important;
}

// ---- Mobile-specific ----
@media (max-width: 991px) {
  // Prevent horizontal overflow on all non-desktop screens
  html, body {
    overflow-x: hidden !important;
    width: 100% !important;
  }

  .main-inner, .header-inner, .content-wrap, .container {
    max-width: 100% !important;
    width: 100% !important;
    padding-right: 0 !important;
    box-sizing: border-box !important;
  }

  .post-body {
    padding-right: 0 !important;
    padding-left: 0 !important;
    max-width: 100% !important;
  }

  // Sidenotes must not float on tablets/phones
  .sidenote, .marginnote {
    float: none !important;
    width: auto !important;
    margin-right: 0 !important;
    margin-left: 0 !important;
  }
}

@media (max-width: 767px) {
  .main-inner {
    width: 95% !important;
    max-width: 100% !important;
    padding: 0 10px !important;
  }

  .post-body {
    padding-right: 0 !important;
    padding-left: 0 !important;
  }

  .post-body mjx-container[display="true"] {
    overflow-x: auto;
    max-width: 100%;
    font-size: 0.85em;
  }

  .lang-switch {
    text-align: center;
  }

  .note {
    padding: 10px 12px;
    font-size: 0.88em;
  }

  .post-title {
    font-size: 1.3em !important;
  }

  body {
    font-size: 15px;
  }
}

// ---- Heading styles ----
.post-body h2 {
  margin-top: 2em;
  padding-bottom: 0.3em;
  border-bottom: 1px solid #eaeaea;
}

.post-body h3 {
  margin-top: 1.5em;
  color: #2c3e50;
}

// ---- TOC ----
.sidebar-nav {
  display: none !important;
}

.post-toc .nav .nav-child {
  display: block;
}

.post-toc-wrap {
  font-size: 0.85em;
  font-family: "Source Sans 3", "Noto Sans SC", sans-serif;
}

// ---- Typography details ----
.post-body p {
  line-height: 1.9;
  margin-bottom: 1em;
}

.post-body ol, .post-body ul {
  line-height: 1.8;
}

.post-body li {
  margin-bottom: 0.3em;
}

// ---- Footnote references - no underline ----
.post-body a[href^="#note-"] {
  text-decoration: none !important;
  border-bottom: none !important;
  box-shadow: none !important;
  color: #1e6e78;
}

.post-body a[href^="#note-"]:hover {
  color: #145a62;
  text-decoration: none !important;
  border-bottom: none !important;
}

// ---- Hide footer ----
.footer {
  display: none;
}

// ---- Language toggle button ----
.lang-switch {
  text-align: right;
  margin-bottom: 1.5em;
  padding: 8px 0;
  border-bottom: 1px solid #eee;
}

.lang-btn {
  display: inline-block;
  padding: 4px 14px;
  margin-left: 6px;
  border: 1px solid #ccc;
  border-radius: 4px;
  background: #fff;
  color: #555;
  font-size: 0.85em;
  font-family: "Source Sans 3", "Noto Sans SC", sans-serif;
  cursor: pointer;
  transition: all 0.2s ease;
}

.lang-btn:hover {
  border-color: #1e6e78;
  color: #1e6e78;
}

.lang-btn.active {
  background: #1e6e78;
  border-color: #1e6e78;
  color: #fff;
  font-weight: 600;
}
